# Скопируй в .env и задай СВОИ значения (особенно POSTGRES_PASSWORD).
# Файл .env в git не коммитится (см. .gitignore).

# --- Postgres (сервис db в docker-compose) ---
POSTGRES_USER=typtap
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=typtap

# DATABASE_URL для api собирается в docker-compose.yml из переменных выше,
# отдельно задавать не нужно. Если запускаешь api без docker (node server.js),
# раскомментируй и подставь свой хост/пароль:
# DATABASE_URL=postgres://typtap:change_me@localhost:5432/typtap
# PORT=8787
